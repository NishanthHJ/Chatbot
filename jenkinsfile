pipeline {
    agent any
    
    environment {
        IMAGE_NAME   = "nishanthhj02/kannadiga-chat-bot:${GIT_COMMIT}"
        AWS_REGION   = "us-east-1"
        CLUSTER_NAME = "karunaadu-cluster"
        NAMESPACE    = "kannadiga"
    }

    stages {

        stage('Git-checkout') {
            steps {
                git url: 'https://github.com/NishanthHJ/Chatbot.git',branch', branch: 'IAC-dev'
            }
        }

        stage('Building-Stage') {
            steps {
                sh '''
                    printenv
                    docker build -t ${IMAGE_NAME} .
                '''
            }
        }

        stage('Login to Docker Hub') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'docker-hub-creds',
                        usernameVariable: 'DOCKER_USERNAME',
                        passwordVariable: 'DOCKER_PASSWORD'
                    )
                ]) {
                    sh 'echo $DOCKER_PASSWORD | docker login -u $DOCKER_USERNAME --password-stdin'
                }
            }
        }

        stage('Pushing to Docker hub') {
            steps {
                sh '''
                    docker push ${IMAGE_NAME}
                '''
            }
        }

        stage('Cluster-Update') {
            steps {
                sh '''
                    aws eks update-kubeconfig \
                      --region ${AWS_REGION} \
                      --name ${CLUSTER_NAME}
                '''
            }
        }

        stage('Deploying to EKS clsuter') {
            steps {
                withKubeConfig(
                    caCertificate: '',
                    clusterName: 'karunaadu-cluster',
                    contextName: '',
                    credentialsId: 'kube',
                    namespace: 'kannadiga',
                    restrictKubeConfigAccess: false,
                    serverUrl: 'https://C9011AAE090779BEEC2295DEE6F2AC5D.gr7.us-east-1.eks.amazonaws.com'
                ) {
                    sh "sed -i 's|replace|${IMAGE_NAME}|g' Deployment.yaml"
                    sh "kubectl apply -f Deployment.yaml -n ${NAMESPACE}"
                }
            }
        }

        stage('Verify the deployment') {
            steps {
                withKubeConfig(
                    caCertificate: '',
                    clusterName: 'karunaadu-cluster',
                    contextName: '',
                    credentialsId: 'kube',
                    namespace: 'kannadiga',
                    restrictKubeConfigAccess: false,
                    serverUrl: 'https://C9011AAE090779BEEC2295DEE6F2AC5D.gr7.us-east-1.eks.amazonaws.com'
                ) {
                    sh "kubectl get pods -n ${NAMESPACE}"
                    sh "kubectl get svc -n ${NAMESPACE}"
                }
            }
        }
    }
}